<section id="valores" class="py-20 bg-slate-100/60 dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800/80 px-6 transition-colors">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Principios Fundamentales</span>
