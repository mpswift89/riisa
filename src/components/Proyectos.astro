---

<section id="proyectos-historial" class="py-20 px-6 max-w-7xl mx-auto border-t border-slate-200 dark:border-slate-800/80 transition-colors">
  
  <!-- Encabezado de la Sección -->
  <div class="text-center max-w-3xl mx-auto mb-12">
    <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Historial de Obras</span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mt-2 transition-colors">
      Proyectos Destacados y Trayectoria
    </h2>
    <p class="mt-4 text-slate-600 dark:text-slate-400 text-sm leading-relaxed transition-colors">
      Más de 40 años ejecutando soluciones electromecánicas para los sectores financiero, comercial, industrial y residencial de la República Dominicana.
    </p>
  </div>

  <!-- Métricas Rápidas -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 text-center">
    <div class="p-4 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <span class="block text-2xl font-black text-blue-600 dark:text-blue-400">+100</span>
      <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Obras Completadas</span>
    </div>
    <div class="p-4 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <span class="block text-2xl font-black text-blue-600 dark:text-blue-400">+25</span>
      <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Sucursales Bancarias</span>
    </div>
    <div class="p-4 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <span class="block text-2xl font-black text-blue-600 dark:text-blue-400">+15</span>
      <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Torres Residenciales</span>
    </div>
    <div class="p-4 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <span class="block text-2xl font-black text-blue-600 dark:text-blue-400">1983</span>
      <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Fundación en Santo Domingo</span>
    </div>
  </div>

  <!-- Controles de Filtrado y Búsqueda -->
  <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-8">
    
    <!-- Botones de Categorías -->
    <div class="flex flex-wrap justify-center gap-2" id="filter-buttons">
      <button data-category="all" class="filter-btn active-filter px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 text-white transition-colors">Todos</button>
      <button data-category="torres" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors">Torres & Sótanos</button>
      <button data-category="banca" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors">Banca & Corporativo</button>
      <button data-category="retail" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors">Retail & Plazas</button>
      <button data-category="institucional" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors">Institucional</button>
      <button data-category="industrial" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors">Industria & Salud</button>
    </div>

    <!-- Buscador de Proyectos -->
    <div class="w-full md:w-64">
      <input
        type="text"
        id="search-input"
        placeholder="Buscar obra o cliente..."
        class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 rounded-xl px-4 py-2 text-xs text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-colors"
      />
    </div>

  </div>

  <!-- Rejilla de Tarjetas de Proyectos -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
    {projects.map((p) => (
      <div 
        class="project-card bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm dark:shadow-none hover:border-blue-500/50 transition-all flex flex-col justify-between"
        data-category={p.category}
        data-name={p.name.toLowerCase()}
      >
        <div>
          <span class="text-[10px] uppercase font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 px-2.5 py-1 rounded-full inline-block mb-3">
            {p.tag}
          </span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white transition-colors">
            {p.name}
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
            {p.services}
          </p>
        </div>
      </div>
    ))}
  </div>

</section>

<!-- Script Cliente para Filtrado y Búsqueda Interactiva -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;

    let currentCategory = 'all';

    function filterProjects() {
      const query = searchInput?.value.toLowerCase().trim() || '';

      cards.forEach((card) => {
        const htmlCard = card as HTMLElement;
        const categoryMatch = currentCategory === 'all' || htmlCard.dataset.category === currentCategory;
        const textMatch = htmlCard.dataset.name?.includes(query);

        if (categoryMatch && textMatch) {
          htmlCard.style.display = 'flex';
        } else {
          htmlCard.style.display = 'none';
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('bg-blue-600', 'text-white', 'active-filter');
          b.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });

        btn.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        btn.classList.add('bg-blue-600', 'text-white', 'active-filter');

        currentCategory = (btn as HTMLElement).dataset.category || 'all';
        filterProjects();
      });
    });

    searchInput?.addEventListener('input', filterProjects);
  });
</script>