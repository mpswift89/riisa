---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "RIISA | Representaciones Internacionales e Industriales, S.R.L.", 
  description = "Especialistas en ingeniería eléctrica, aire acondicionado, ventilación mecánica, cuartos fríos y pre-instalaciones con más de 40 años de trayectoria en República Dominicana (desde 1983)." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Prevent Theme Flash Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between transition-colors duration-300">
    
    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-slate-950/80 border-b border-slate-200 dark:border-slate-800 transition-colors">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        
        <!-- Branding (Root Route Option 1) -->
        <a href="/" class="flex flex-col group">
          <span class="text-2xl font-black tracking-wider text-blue-600 dark:text-blue-500 uppercase">
            RII<span class="text-slate-900 dark:text-white">SA</span>
          </span>
          <span class="text-[9px] text-slate-500 dark:text-slate-400 font-medium tracking-tight -mt-1 hidden sm:block">
            Representaciones Internacionales e Industriales, S.R.L.
          </span>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex space-x-8 text-sm font-semibold text-slate-700 dark:text-slate-300">
          <a href="#nosotros" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Nosotros</a>
          <a href="#servicios" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Servicios</a>
          <a href="#proyectos-historial" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Proyectos</a>
          <a href="#contacto" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contacto</a>
        </nav>

        <div class="flex items-center gap-4">
          <!-- Day / Night Mode Toggle Button -->
          <button
            id="themeToggle"
            type="button"
            aria-label="Toggle theme"
            class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-800 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="sunIcon" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="moonIcon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Action Button -->
          <a href="#contacto" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-xl font-bold text-sm transition shadow-md shadow-blue-600/20">
            Cotizar Proyecto
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-400 py-16 px-6 border-t border-slate-800/80 transition-colors">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
        
        <!-- Columna 1: Branding e Identidad -->
        <div>
          <a href="/" class="text-3xl font-black text-white tracking-wider hover:text-blue-500 transition-colors inline-block">
            RIISA
          </a>
          <p class="mt-2 text-xs text-blue-400 font-semibold uppercase tracking-wider">
            Representaciones Internacionales e Industriales, S.R.L.
          </p>
          <p class="mt-4 text-xs leading-relaxed text-slate-400">
            Ingeniería Eléctrica, Ventilación Mecánica, Cuartos Fríos y Aire Acondicionado. Más de 40 años respaldando obras de alta complejidad técnica en la República Dominicana.
          </p>
          <div class="mt-4 flex flex-col gap-1.5">
            <span class="inline-block text-[11px] font-semibold text-blue-400 bg-blue-500/10 border border-blue-500/20 px-3 py-1 rounded-full w-fit">
              Fundada el 28 de Febrero de 1983
            </span>
            <span class="text-[11px] text-slate-500 font-medium">RNC: 101-11710-9</span>
          </div>
        </div>

        <!-- Columna 2: Especialidades -->
        <div>
          <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-4">Especialidades Técnicas</h4>
          <ul class="space-y-2.5 text-xs text-slate-400">
            <li>• Ventilación Mecánica (Sótanos e Inyección/Extracción)</li>
            <li>• Presurización de Escaleras y Control de Humo</li>
            <li>• Pre-instalaciones A/C en Torres Residenciales</li>
            <li>• Instalaciones Eléctricas & Subestaciones</li>
            <li>• Cuartos Fríos y Refrigeración Comercial/Industrial</li>
          </ul>
        </div>

        <!-- Columna 3: Contacto Directo -->
        <div>
          <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-4">Ubicación y Contacto</h4>
          <ul class="space-y-4 text-xs">
            <li class="flex items-start gap-3">
              <div class="p-2 bg-slate-900 border border-slate-800 rounded-lg text-blue-500 shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="text-[10px] text-slate-500 block uppercase font-semibold">Oficina Principal</span>
                <span class="text-slate-200 font-medium leading-tight block mt-0.5">
                  Rafael Augusto Sánchez #46, Edif. Ana Judith, Apto. 101A, Naco, Santo Domingo
                </span>
              </div>
            </li>
            <li class="flex items-center gap-3">
              <div class="p-2 bg-slate-900 border border-slate-800 rounded-lg text-blue-500 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <span class="text-[10px] text-slate-500 block uppercase font-semibold">Teléfono</span>
                <a href="tel:8095668264" class="text-slate-200 hover:text-white font-bold transition-colors">809-566-8264</a>
              </div>
            </li>
            <li class="flex items-center gap-3">
              <div class="p-2 bg-slate-900 border border-slate-800 rounded-lg text-blue-500 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="text-[10px] text-slate-500 block uppercase font-semibold">Correo Electrónico</span>
                <a href="mailto:gvega.riisa@gmail.com" class="text-slate-200 hover:text-white font-bold transition-colors break-all">gvega.riisa@gmail.com</a>
              </div>
            </li>
            <li class="flex items-center gap-3">
              <div class="p-2 bg-slate-900 border border-slate-800 rounded-lg text-blue-500 shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <span class="text-[10px] text-slate-500 block uppercase font-semibold">Instagram</span>
                <a href="https://instagram.com/riisa_srl" target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-white font-bold transition-colors">@riisa_srl</a>
              </div>
            </li>
          </ul>
        </div>

      </div>

      <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-slate-900 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
        <p>© RIISA. Todos los derechos reservados.</p>
        <p>Ingeniería, Instalaciones y Soluciones Electromecánicas</p>
      </div>
    </footer>

    <!-- Toggle Theme Script -->
    <script>
      const toggle = document.getElementById('themeToggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>