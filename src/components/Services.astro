---
const services = [
  {
    title: "Ventilación Mecánica & Extracción",
    desc: "Sistemas de extracción de monóxido (CO) e inyección de aire en sótanos/parqueos, presurización de escaleras contra incendios y ductos de basura.",
    tag: "Especialidad en Torres"
  },
  {
    title: "Pre-instalaciones para A/C",
    desc: "Trazado, embutido y sellado bajo presión de tuberías de cobre en obra gris, garantizando hermeticidad y protección de muros antes de los acabados.",
    tag: "Etapa de Obra Gris"
  },
  {
    title: "Aire Acondicionado & HVAC",
    desc: "Suministro, fabricación de ductería metálica a medida e instalación de sistemas de alta eficiencia, VRF y climatización comercial e industrial.",
    tag: "Eficiencia Energética"
  },
  {
    title: "Ingeniería e Instalaciones Eléctricas",
    desc: "Montaje de transformadores, paneles principales (Panel Board), switches de transferencia, tendido de cableado, tomacorrientes y balanceo de cargas.",
    tag: "Alta Seguridad"
  },
  {
    title: "Sistemas de Refrigeración",
    desc: "Soluciones de refrigeración técnica, comercial e industrial adaptadas a los requerimientos de control de temperatura de cada proyecto.",
    tag: "Control de Temperatura"
  },
  {
    title: "Diseño & Planificación de Proyectos",
    desc: "Elaboración y replanteo de planos electromecánicos para optimizar recursos, garantizar el rigor normativo y agilizar la ejecución.",
    tag: "Planificación Integral"
  },
  {
    title: "Supervisión Técnica de Obras",
    desc: "Fiscalización continua en campo para verificar el cumplimiento exacto de especificaciones técnicas, estándares de calidad y normas de seguridad.",
    tag: "Garantía de Calidad"
  },
  {
    title: "Mantenimiento Preventivo & Correctivo",
    desc: "Servicio técnico especializado y atención de emergencias para extender la vida útil y eficiencia operativa de sus equipos e instalaciones.",
    tag: "Soporte Técnico"
  }
];
---

<section id="servicios" class="py-20 px-6 max-w-7xl mx-auto border-t border-slate-200 dark:border-slate-800/80 transition-colors">
  <div class="text-center max-w-2xl mx-auto mb-16">
    <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Especialidades</span>
    <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl mt-2 transition-colors">Nuestros Servicios</h2>
    <p class="mt-4 text-slate-600 dark:text-slate-400 text-sm transition-colors">Soluciones electromecánicas integrales desde el diseño y planificación hasta la instalación en obra y mantenimiento.</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {services.map((s) => (
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-8 rounded-2xl hover:border-blue-500/50 shadow-sm dark:shadow-none transition duration-300 flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 px-3 py-1 rounded-full transition-colors inline-block">
            {s.tag}
          </span>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-4 transition-colors">{s.title}</h3>
          <p class="mt-3 text-slate-600 dark:text-slate-400 text-sm leading-relaxed transition-colors">{s.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>