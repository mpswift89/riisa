---
const services = [
  {
    title: "Instalaciones Eléctricas",
    desc: "Montaje, cableado y distribución eléctrica segura para proyectos comerciales, industriales y residenciales.",
    tag: "Alta Seguridad"
  },
  {
    title: "Climatización y Aire Acondicionado",
    desc: "Instalación de sistemas de aire acondicionado de alta eficiencia y tecnología VRF.",
    tag: "Eficiencia Energética"
  },
  {
    title: "Sistemas de Refrigeración",
    desc: "Soluciones de refrigeración técnica y comercial adaptadas a los requerimientos de cada cliente.",
    tag: "Control de Temperatura"
  },
  {
    title: "Diseño de Proyectos",
    desc: "Planificación técnica integral antes de la ejecución para optimizar recursos y asegurar el cumplimiento de normativas.",
    tag: "Planificación Integral"
  },
  {
    title: "Supervisión de Obras",
    desc: "Fiscalización técnica continua para garantizar que cada instalación cumpla con los estándares de calidad y seguridad.",
    tag: "Garantía de Calidad"
  },
  {
    title: "Mantenimiento Preventivo y Correctivo",
    desc: "Servicio técnico y atención de emergencias para extender la vida útil de sus equipos e instalaciones.",
    tag: "Soporte Técnico"
  }
];
---

<section id="servicios" class="py-20 px-6 max-w-7xl mx-auto border-t border-slate-200 dark:border-slate-800/80 transition-colors">
  <div class="text-center max-w-2xl mx-auto mb-16">
    <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Especialidades</span>
    <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl mt-2 transition-colors">Nuestros Servicios</h2>
    <p class="mt-4 text-slate-600 dark:text-slate-400 text-sm transition-colors">Ofrecemos un servicio integral desde el diseño hasta la ejecución final.</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {services.map((s) => (
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-8 rounded-2xl hover:border-blue-500/50 shadow-sm dark:shadow-none transition duration-300 flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 px-3 py-1 rounded-full transition-colors inline-block">
            {s.tag}
          </span>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-4 transition-colors">{s.title}</h3>
          <p class="mt-3 text-slate-600 dark:text-slate-400 text-sm leading-relaxed transition-colors">{s.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>